# Reference only: Spring Boot does not automatically load this file.
# Export these variables in your terminal/IDE or pass them through Docker Compose.
DB_URL=jdbc:mariadb://localhost:3306/furniture_shop
DB_USERNAME=root
DB_PASSWORD=
REDIS_HOST=localhost
REDIS_PORT=6379
# Legacy JWT application only; commerce runtime uses session + CSRF instead.
# Base64-encoded random secret, at least 32 decoded bytes. Do not reuse examples.
JWT_SECRET=
GEMINI_API_KEY=
# Opt-in public catalog indexing; disabled startup makes no embedding requests.
# Requires all registered V001-V014 migrations; model is fixed to gemini-embedding-001, 768 dimensions.
VECTOR_ENABLED=false
VECTOR_BATCH_SIZE=5
VECTOR_INTERVAL_SECONDS=60
VECTOR_MAX_ATTEMPTS=8
# TV3 manual payments. DEMO only works with the isolated TV3 dev/test database.
# MANUAL requires complete public payee details; this does not integrate a bank API.
PAYMENT_BANK_MODE=UNCONFIGURED
PAYMENT_BANK_NAME=
PAYMENT_BANK_ACCOUNT_NUMBER=
PAYMENT_BANK_ACCOUNT_HOLDER=
# New positive-total COD orders only; existing orders and bank transfers are excluded.
ORDER_CONFIRMATION_TTL_SECONDS=86400
COMMERCE_JOBS_ENABLED=true
ORDER_EXPIRY_ENABLED=true
ORDER_NOTIFICATIONS_ENABLED=true
COMMERCE_JOB_DELAY_MS=10000
# SePay Webhooks Test mode, independent from manual bank instructions.
# Copy into an ignored .env.sepay.local; scripts/tv3_sepay.py loads it explicitly.
SEPAY_ENABLED=false
SEPAY_BANK=VietinBank
SEPAY_ACCOUNT_NUMBER=
SEPAY_ACCOUNT_HOLDER=
SEPAY_WEBHOOK_SECRET=
SEPAY_API_TOKEN=
SEPAY_WEBHOOK_ID=
# New SePay attempts only; API uncertainty never authorizes expiry.
SEPAY_AUTOMATION_ENABLED=true
SEPAY_PAYMENT_TTL_SECONDS=1800
SEPAY_RECONCILIATION_INTERVAL_SECONDS=60
SEPAY_BATCH_SIZE=5
SEPAY_LATE_RECONCILIATION_HOURS=72
# Provider refunds require explicit staff submit and a Test API token with write permission.
SEPAY_REFUNDS_ENABLED=false
